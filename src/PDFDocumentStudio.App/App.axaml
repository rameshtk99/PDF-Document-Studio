<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:PDFDocumentStudio.App.Services"
             x:Class="PDFDocumentStudio.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- Dark "glass" palette. Every color here is explicit (not tied to system accent/theme) so
         the app looks the same regardless of OS theme settings. -->
    <Application.Resources>
        <services:AlignToIndexConverter x:Key="AlignToIndexConverter" />
        <SolidColorBrush x:Key="AppBackgroundBrush">#0F1017</SolidColorBrush>
        <SolidColorBrush x:Key="PanelBackgroundBrush">#1A1B26</SolidColorBrush>
        <SolidColorBrush x:Key="PanelDarkBrush">#14151F</SolidColorBrush>
        <SolidColorBrush x:Key="CardBackgroundBrush">#1A1B26</SolidColorBrush>
        <SolidColorBrush x:Key="ControlBackgroundBrush">#252736</SolidColorBrush>
        <SolidColorBrush x:Key="ChipBackgroundBrush">#2A2C3D</SolidColorBrush>
        <SolidColorBrush x:Key="CanvasSurroundBrush">#0F1017</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush1">#2A2C3D</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush2">#33354A</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush">#E1E1E6</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondaryBrush">#A0A5C0</SolidColorBrush>
        <SolidColorBrush x:Key="TextMutedBrush">#6C7293</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#6366F1</SolidColorBrush>
        <SolidColorBrush x:Key="AccentSoftBrush">#A5B4FC</SolidColorBrush>
        <SolidColorBrush x:Key="AccentFillBrush">#383B52</SolidColorBrush>
    </Application.Resources>
</Application>
